# cached upstream data — regenerate with scripts/fetch_osm.py
data/raw/
data/interim/
data/processed/*

# The generated distance matrices are deliberately NOT committed. They are a
# Derivative Database of OpenStreetMap and carry ODbL, which is not ours to
# waive — committing them would put a second licence in a repository that ships
# GPLv3 in totality. See data/processed/taxi_distance/ODbL-NOTICE.md, which is
# committed because it is our own documentation rather than OSM-derived data.
!data/processed/taxi_distance/
data/processed/taxi_distance/*
!data/processed/taxi_distance/README.md
!data/processed/taxi_distance/ODbL-NOTICE.md

# challenge datasets (never commit; distributed under challenge terms)
*.parquet
challenge_data/

# credentials — Minio/OpenSky bucket keys
.env
*.env
secrets.toml
credentials*

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# os
.DS_Store
